{
  "name": "yomigana",
  "version": "1.0.1",
  "description": "Automatic Japanese reading annotations for the web.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./yomigana.css": "./src/yomigana.css",
    "./presets/global-overrides.js": "./presets/global-overrides.js"
  },
  "files": [
    "src/",
    "presets/",
    "vendor/suzume/",
    "vendor/kuromoji/",
    "vendor/readings/*.json",
    "vendor/readings/NOTICE.txt",
    "dist/"
  ],
  "keywords": [
    "japanese",
    "furigana",
    "yomigana",
    "ruby",
    "kanji",
    "reading"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build:kuromoji && npm run build:offline",
    "build:kuromoji": "node scripts/build-kuromoji.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/serve-demos.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@libraz/suzume": "0.9.11",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "kuromoji": "0.1.2"
  }
}
